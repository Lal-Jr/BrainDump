# Required in production (the server refuses to start without them)
JWT_SECRET=          # at least 32 random characters:  openssl rand -hex 32
ADMIN_PASSWORD=      # at least 8 characters

# AI drafting (voice / text -> post). Optional: without it the "blank draft" path still works
OPENAI_API_KEY=

# Optional
PORT=3001
DATA_DIR=            # where posts, uploads, comments live (a mounted volume in production)
SITE_URL=            # the portfolio's public origin, e.g. https://harishlal.dev (RSS + sitemap links)
TRUST_PROXY=2        # reverse proxies in front of this server: Fly's edge + the portfolio's /blog rewrite
